# Public browser configuration only. Never put service_role keys here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Express server configuration. Keep real private values outside the repository.
NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-characters
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLIC_KEY=sb_publishable_replace_me
# Server only. Set in the hosting provider's encrypted secret manager.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace-me\n-----END PUBLIC KEY-----"
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----"
JWT_ISSUER=https://issuer.example.com
JWT_AUDIENCE=albarka-api
TRUST_PROXY=false
LOG_LEVEL=info
STORAGE_ROOT=./storage